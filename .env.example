# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it. Secrets that leak into git history
# stay there even after the file is deleted.

# --- Database (docker-compose postgres) ---
DATABASE_URL=postgresql://jobrunner:jobrunner@localhost:5432/jobrunner

# --- App behavior ---
# Nothing submits without approval unless this is explicitly flipped to true,
# and even then only per-profile above MIN_MATCH_SCORE. See CLAUDE.md §2.
AUTO_SUBMIT=false
MIN_MATCH_SCORE=0.75

# --- Worker ---
# Stable identity so a restarted worker recognizes the lease it left behind.
# Defaults to the machine hostname when unset.
WORKER_ID=
# Seconds a claimed task stays owned before another worker may reclaim it.
LEASE_SECONDS=300

# --- LLM provider ---
# One of: ollama | gemini | anthropic | openrouter | stub
# stub is what tests use — no test may hit a network LLM.
LLM_PROVIDER=stub
OLLAMA_BASE_URL=http://localhost:11434
# Which local model answers the assistant. Anything Ollama serves works, but
# a `:cloud` model is refused by /chat — Ollama serves those from its own
# servers, and CLAUDE.md §14 keeps the assistant on this machine.
OLLAMA_MODEL=llama3.1

# --- Ollama's hosted models (CLAUDE.md §14) ---
# A model Ollama runs on its own servers, reached through the same
# localhost:11434 API as a local one. Because nothing in the URL says so, it is
# a separate provider name rather than a `:cloud` tag on OLLAMA_MODEL — that
# one is still refused, since asking for the local model and silently getting a
# third party is not a decision.
#
# Naming a model here is what makes the provider reachable; there is no API key
# to paste when the local daemon is signed in. It stays out of the automatic
# "auto" order for exactly that reason — one line should not redirect every
# task off the machine. Reach it with LLM_PROVIDER=ollama_cloud, one of the
# LLM_TASK_* settings, the /chat picker, or the compare panel.
# OLLAMA_CLOUD_MODEL=glm-5.3-flash:cloud
# Only for pointing OLLAMA_BASE_URL at ollama.com directly.
# OLLAMA_API_KEY=

# --- Which model answers which task (CLAUDE.md §7) ---
# "auto" takes the strongest configured provider, which is what ships. Naming
# one pins that task, so you can tailor locally without deleting the API key
# every other task wants kept.
#   auto | ollama | gemini | anthropic | openrouter
LLM_TASK_TAILOR=auto
LLM_TASK_COVER_LETTER=auto
LLM_TASK_OPEN_ENDED=auto

# Inbound-email classification and the assistant are deliberately absent from
# that list. They read recruiter mail and chat context, §2.8 permits one
# third-party upload and neither is it, so both are pinned to Ollama in code
# and no setting can move them.

# On a spent daily quota or an unreachable remote provider, answer with the
# local model instead of refusing. Never falls back to the stub — canned text
# must not reach a real application. The audit trail records which answered.
LLM_FALLBACK_LOCAL=true
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- OpenRouter ---
# One key, many upstream models. Setting it changes nothing on its own:
# OpenRouter is deliberately left out of the "auto" quality order, so it answers
# only when you name it — LLM_PROVIDER=openrouter, or LLM_TASK_TAILOR=openrouter.
#
# Why it has to be named rather than inherited: OpenRouter forwards your résumé
# text to an upstream provider, and the audit trail can record the hop but not
# the destination. On a cloaked `stealth/*` route the upstream vendor is
# undisclosed by design, and free routes commonly log prompts and share them
# with that undisclosed creator. §2.8 permits one third-party upload and asks
# that it be auditable — so this is a choice to make on purpose, after reading
# the route's data policy, not one to acquire by pasting a key.
OPENROUTER_API_KEY=
# Defaults to stealth/ox-alpha. Pre-release routes are withdrawn without notice
# and every call then 404s; this is the one-line fix when that happens.
OPENROUTER_MODEL=

# --- Secrets vault ---
# Fernet key used to encrypt ATS account credentials at rest (packages/core/vault.py).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=
# Kept outside storage/ so encrypted credentials never travel with the
# résumés and screenshots you might copy off the machine.
VAULT_ROOT=./.secrets

# --- Managed inbox (recruiter reply tracking, +alias addressing) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
INBOX_ALIAS_BASE=you@gmail.com

# --- Matching ---
# lexical (default, offline, vocabulary overlap) or sentence-transformers
# (BAAI/bge-small-en-v1.5, genuinely semantic, ~130MB download on first use).
# Switching backends requires re-embedding: vectors are not comparable.
EMBEDDING_BACKEND=lexical

# --- Crawler ---
# Minimum seconds between requests to the same host. Configurable up, never down.
CRAWLER_MIN_DELAY_S=60

# Search — the owner's standing filter, not the profile (CLAUDE.md §1).
# United States only, ranked Bay Area, then the rest of California, then the
# rest of the country. Override for one call with ?us_only=false.
SEARCH_US_ONLY=true

# --- GitHub (project import for resumes) ---
# Optional. Without it: 60 API requests/hour, public repositories only.
# A read-only token raises that to 5000/hour and allows private repos.
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- Storage ---
STORAGE_ROOT=./storage
# Largest single audit artifact (screenshot, receipt) to keep, in MB.
STORAGE_MAX_FILE_MB=10

# --- API ---
# The API has no authentication and can submit real job applications, so it
# refuses non-loopback callers. Only set true behind your own auth.
ALLOW_NON_LOCAL=false
