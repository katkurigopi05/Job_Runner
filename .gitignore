# Secrets — never commit
# `.env.*` and not just `.env.local`: a backup made before editing settings
# (`.env.bak`, `.env.2026-08-24`, `.env.save`) is a full copy of the vault key
# and every credential, and the old two-line form left it untracked-but-
# visible, one `git add -A` from being committed. `.env.example` is the
# documented template and carries no values, so it is exempted back in.
.env
.env.*
# iCloud writes conflict copies as "name 2" with no extension, and it has
# already reached inside .git here. The repo-wide `* [0-9].*` rule needs a
# trailing extension, so it does not match `.env 2` — a verbatim copy of the
# vault key that would otherwise sit untracked-but-visible.
.env [0-9]*
!.env.example
*.pem
*.key
.secrets/

# PII / user data — resumes, tailored PDFs, screenshots, browser profiles
storage/
*.pdf
*.docx
*.rtf
*.odt
# A résumé dropped outside storage/ is still a résumé. Extension rules above
# miss resume.txt and resume.md, which is exactly how one gets committed by
# hand while the app's own copies stay ignored.
/resume*
/Resume*
/RESUME*
# Claude Code session state. Both files were ignored only by machine-local
# rules — ~/.config/git/ignore and .git/info/exclude — neither of which
# travels with a clone, so a second checkout could commit them.
.claude/RESUME.md
.claude/settings.local.json

# Python
# Both forms: `.venv/` matches the real directory, `.venv` matches the symlink
# a worktree uses. Only the first was listed, so a worktree's symlink was
# committable — and was committed, pointing at an absolute path on one machine.
.venv
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/

# Playwright
playwright-report/
test-results/

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Next.js build artifacts
apps/web/.next/
apps/web/tsconfig.tsbuildinfo
apps/web/next-env.d.ts

# Company lists
bay_area_tech_companies.csv
*.companies.csv

# Knowledge-graph output (graphify)
graphify-out/

# One-off analysis output — scraped listings, regenerated by scripts/adhoc/
sde_results.txt

# iCloud Drive conflict copies. This repo sits under ~/Desktop, which macOS
# syncs to iCloud, and iCloud writes "foo 2.py" beside "foo.py" — including
# inside .git. They are never ours and must never be committed.
* [0-9].*
