# Keep the build context small and keep secrets and PII out of the image.

# Secrets — must never enter an image layer
.env
.env.local
.secrets/
*.pem
*.key

# PII — résumés, tailored PDFs, screenshots, browser profiles
storage/

# Local virtualenv: wrong platform, and it would shadow the container's
.venv/
venv/

# Machine-specific compose overrides (port remaps and the like)
docker-compose.override.yml

__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

.git/
.github/
node_modules/
.next/
playwright-report/
test-results/

.DS_Store
.vscode/
.idea/
*.log
