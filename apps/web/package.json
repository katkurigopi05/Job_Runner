{
  "name": "jobrunner-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H ${JOBRUNNER_WEB_HOST:-127.0.0.1} -p ${JOBRUNNER_WEB_PORT:-3001}",
    "build": "next build",
    "start": "next start -H ${JOBRUNNER_WEB_HOST:-127.0.0.1} -p ${JOBRUNNER_WEB_PORT:-3000}",
    "lint": "eslint",
    "test:dependencies": "node --test tooling/minimatch-compat.test.cjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.107.1",
    "border-beam": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "thinking-orbs": "0.3.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.29",
    "minimatch": "file:tooling/minimatch-compat",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "$minimatch"
    },
    "@eslint/eslintrc": {
      "minimatch": "$minimatch"
    },
    "eslint": {
      "minimatch": "$minimatch"
    },
    "eslint-plugin-import": {
      "minimatch": "$minimatch"
    },
    "eslint-plugin-react": {
      "minimatch": "$minimatch"
    },
    "eslint-plugin-jsx-a11y": {
      "minimatch": "$minimatch"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "next": {
      "postcss": "8.5.26"
    }
  }
}
